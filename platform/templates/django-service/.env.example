# Copia a .env (cp .env.example .env). NUNCA subas .env al repositorio.
SERVICE_NAME=__SERVICE__
DEBUG=true
SECRET_KEY=cambia-esto-en-local
ALLOWED_HOSTS=*
LOG_LEVEL=INFO
PORT=__PORT__
# Sin DATABASE_URL se usa SQLite local. Para usar la BD del compose (levántala con
# `podman compose -f platform/deploy/local/compose.yaml up -d __SERVICE__-db`), descomenta:
# DATABASE_URL=postgres://__SERVICE__:__SERVICE__@localhost:__DBPORT__/__SERVICE__
