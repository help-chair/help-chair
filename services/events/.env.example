# Copia a .env para desarrollo local. Nunca subas .env ni incluyas secretos reales.
# Copy to .env for local development. Never commit .env or put real secrets here.

SERVICE_NAME=events
DEBUG=True
SECRET_KEY=replace-with-a-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# TimescaleDB usa el protocolo PostgreSQL. Esta URL es para ejecutar desde el host.
# TimescaleDB uses PostgreSQL's protocol. This URL is for running from the host.
DATABASE_URL=postgresql://events:events@localhost:5441/events
# Dentro de Compose se conecta a events-db:5432; compose.yaml ya define esa URL.
# Inside Compose, connect to events-db:5432; compose.yaml sets that URL.

# Valores predeterminados del contenedor / Container defaults
PORT=8001
WEB_CONCURRENCY=2
