
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://help-chair.com/contracts/messages/requests/event-routed.requests.v1.schema.json",
  "title": "Mensajes de Eventos hacia Peticiones",
  "description": "Perfil v1 de recepción de event.routed con destino REQUESTS.",
  "allOf": [
    {
      "$ref": "../event-envelope.json"
    },
    {
      "type": "object",
      "properties": {
        "origin": {
          "const": "events"
        },
        "type": {
          "const": "event.routed"
        },
        "version": {
          "const": 1
        },
        "payload": {
          "type": "object",
          "required": [
            "destination",
            "rule_code",
            "category"
          ],
          "properties": {
            "destination": {
              "const": "REQUESTS"
            },
            "rule_code": {
              "const": "R5"
            },
            "category": {
              "const": "REQUEST"
            }
          }
        }
      }
    }
  ]
}
