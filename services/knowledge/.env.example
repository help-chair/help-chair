# Copia a .env (cp .env.example .env o make setup). NUNCA subas .env / Copy to .env. Never commit .env
SERVICE_NAME=knowledge
DEBUG=true
SECRET_KEY=cambia-esto-en-local
ALLOWED_HOSTS=*
LOG_LEVEL=INFO
PORT=8006

# Sin DATABASE_URL se usa SQLite local, suficiente para `make test` y `make run`.
# Para usar la BD del compose, levántala con
# `podman compose -f platform/deploy/local/compose.yaml up -d knowledge-db`
# y descomenta la línea siguiente:
# DATABASE_URL=postgres://knowledge:knowledge@localhost:5446/knowledge

# Broker de mensajes (fase 2).
BROKER_URL=
