// CI del frontend. Adaptación de platform/templates/README-jenkins.md.
// Plataforma debe proveer un agente Linux con Node 20+ y crear el job multibranch.
pipeline {
  agent any

  options {
    skipDefaultCheckout(true)
    disableConcurrentBuilds()
    timeout(time: 30, unit: 'MINUTES')
    buildDiscarder(logRotator(numToKeepStr: '15'))
  }

  parameters {
    booleanParam(
      name: 'FORCE_CI',
      defaultValue: false,
      description: 'Ejecuta CI aunque no haya cambios en frontend.'
    )
  }

  environment {
    CI = 'true'
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('CI del frontend') {
      when {
        anyOf {
          changeset pattern: 'frontend/**', comparator: 'GLOB', caseSensitive: true
          // El primer build del job puede no tener changelog.
          expression { currentBuild.number == 1 }
          expression { params.FORCE_CI == true }
        }
      }

      stages {
        stage('Prepare') {
          steps {
            dir('frontend') {
              sh 'npm ci --no-audit --no-fund'
            }
          }
        }

        stage('Lint') {
          steps {
            dir('frontend') {
              sh 'npm run lint'
            }
          }
        }

        stage('Typecheck') {
          steps {
            dir('frontend') {
              sh 'npm run typecheck'
            }
          }
        }

        stage('Test') {
          steps {
            dir('frontend') {
              sh 'npm run test:coverage'
            }
          }
        }

        stage('Build') {
          steps {
            dir('frontend') {
              sh 'npm run build'
            }
          }
        }
      }
    }
  }
}
