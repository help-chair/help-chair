# Copia a .env para desarrollo local. Nunca subas .env ni incluyas secretos reales.
# Copy to .env for local development. Never commit .env or put real secrets here.

SERVICE_NAME=events
DEBUG=True
SECRET_KEY=replace-with-a-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
# TimescaleDB usa el protocolo PostgreSQL. Esta URL es para ejecutar desde el host.
DATABASE_URL=postgresql://events:events@localhost:5441/events
# Dentro de Compose se conecta a events-db:5432; compose.yaml ya define esa URL.
# Valores predeterminados del contenedor / Container defaults
PORT=8001
WEB_CONCURRENCY=2
EVENT_SEVERITY_KEY=severity
EVENT_THRESHOLD_DEFAULT=3
EVENT_WINDOW_DAYS_DEFAULT=7
ALLOW_ACTOR_HEADER=true
# Broker (NATS con JetStream). Compose y Helm ya inyectan nats://broker:4222.
# Vacío = los mensajes se quedan en outbox_message hasta que haya broker.
BROKER_URL=nats://localhost:4222
OUTBOX_STREAM=EVENTS
OUTBOX_STREAM_MAX_AGE_DAYS=7
OUTBOX_PUBLISH_TIMEOUT_SECONDS=5
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=10
OUTBOX_BACKOFF_BASE_SECONDS=5
OUTBOX_BACKOFF_MAX_SECONDS=900
OUTBOX_POLL_INTERVAL_SECONDS=2
# Plan B (sin broker): OUTBOX_TRANSPORT=http y rutas `patrón=url1,url2;patrón=url3`.
OUTBOX_TRANSPORT=jetstream
OUTBOX_HTTP_ROUTES=
# Token opcional para el receptor (Authorization: Bearer). No subas uno real.
OUTBOX_HTTP_TOKEN=

# Consumidor duradero de mensajes de Accesos (el stream ACCESS debe incluir access.>).
ACCESS_EVENTS_STREAM=ACCESS
ACCESS_EVENTS_SUBJECT=access.>
ACCESS_EVENTS_DURABLE=events-access-v1
ACCESS_EVENTS_BATCH_SIZE=20
ACCESS_EVENTS_FETCH_TIMEOUT_SECONDS=5
LOGIN_FAILED_THRESHOLD=5
LOGIN_FAILED_WINDOW_SECONDS=300

# Deduplicación de eventos (ver docs/deduplicacion.md)
EVENT_FUZZY_ENABLED=false
EVENT_FUZZY_THRESHOLD=0.95
EVENT_FUZZY_TYPES=WARNING,INFORMATION
EVENT_MASK_SHORT_NUMBERS=false
