# Copia a .env (cp .env.example .env). Las variables VITE_* son visibles en el navegador:
# NUNCA pongas secretos aquí.

# --- Desarrollo: destinos del proxy de Vite (el cliente usa rutas relativas /api/...) ---
VITE_API_GATEWAY_URL=http://localhost:8000
VITE_API_EVENTS_URL=http://localhost:8001
VITE_API_ACCESS_URL=http://localhost:8002
VITE_API_REQUESTS_URL=http://localhost:8003
VITE_API_INCIDENTS_URL=http://localhost:8004
VITE_API_PROBLEMS_URL=http://localhost:8005
VITE_API_KNOWLEDGE_URL=http://localhost:8006

# true = el gateway es el mock de Prism (npm run mock:gateway), que no usa el prefijo /api/public/v1
VITE_GATEWAY_MOCK=false

# Activa datos simulados cuando no haya backends
VITE_USE_MOCKS=true
# Identificador de empresa en local
VITE_DEV_TENANT_ID=empresa-demo

# --- Producción ---
# No hay variables de compilación: la misma imagen sirve a todos los ambientes.
# El dominio se configura al ARRANCAR el contenedor con BASE_DOMAIN (ver DEPLOYMENT.md).
