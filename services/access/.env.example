# Copia a .env (cp .env.example .env). NUNCA subas .env al repositorio.
SERVICE_NAME=access
DEBUG=true
SECRET_KEY=cambia-esto-en-local
ALLOWED_HOSTS=*
LOG_LEVEL=INFO
PORT=8002

# Empresa dueña de este stack. Va en el claim "empresa" del token.
EMPRESA_ID=empresa-demo

# Vigencia de los tokens.
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=1

# Llave privada RSA con la que se firma el token (RS256). Genérala con
# `make llaves` y pégala aquí con los saltos de línea escapados como \n.
# Si la dejas vacía y DEBUG=true, se genera una de desarrollo en
# build/jwt-dev.pem, que no se versiona. Fuera de desarrollo es obligatoria.
JWT_PRIVATE_KEY=

# Sin DATABASE_URL se usa SQLite local, suficiente para `make test`.
# Para usar la BD del compose, levántala con
# `docker compose -f platform/deploy/local/compose.yaml up -d access-db`
# y descomenta la línea siguiente:
# DATABASE_URL=postgres://access:access@localhost:5442/access

# Intentos fallidos consecutivos antes de bloquear la cuenta. El contrato dice 3.
INTENTOS_ANTES_DE_BLOQUEAR=3

# Horas que vive el enlace de activación. El contrato dice 72.
ACTIVACION_VIGENCIA_HORAS=72

# Secreto que usa el aprovisionador para crear al administrador inicial.
# Vacío = /internal/v1/bootstrap-admin queda cerrado.
PROVISIONER_TOKEN=
