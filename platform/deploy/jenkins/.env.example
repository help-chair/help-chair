# Copia a .env y completa. Nunca subas .env / Copy to .env and fill in. Never commit .env
# Guía: docs/runbooks/jenkins.md

# URL con la que se entra a Jenkins (cambia al moverlo a una VM)
JENKINS_URL=http://localhost:8090/

# Contraseñas de los usuarios de Jenkins (una por equipo + administración)
JENKINS_ADMIN_PASSWORD=
JENKINS_PASS_EVENTS=
JENKINS_PASS_ACCESS=
JENKINS_PASS_REQUESTS=
JENKINS_PASS_INCIDENTS=
JENKINS_PASS_PROBLEMS=
JENKINS_PASS_FRONTEND=

# GitHub: token de solo lectura del repo (fine-grained: Contents=Read, Metadata=Read)
GITHUB_USER=
GITHUB_TOKEN=

# GHCR: token classic con el permiso write:packages (para publicar imágenes)
GHCR_USER=
GHCR_TOKEN=
