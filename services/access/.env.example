# Copia a .env (cp .env.example .env). NUNCA subas .env al repositorio.
SERVICE_NAME=access
DEBUG=true
SECRET_KEY=cambia-esto-en-local
ALLOWED_HOSTS=*
LOG_LEVEL=INFO
PORT=8002

# Empresa dueña de este stack. Va en el claim "empresa" del token.
EMPRESA_ID=empresa-demo

# Vigencia de los tokens.
ACCESS_TOKEN_MINUTOS=15
REFRESH_TOKEN_DIAS=1

# Sin DATABASE_URL se usa SQLite local, suficiente para `make test`.
# Para usar la BD del compose, levántala con
# `docker compose -f platform/deploy/local/compose.yaml up -d access-db`
# y descomenta la línea siguiente:
# DATABASE_URL=postgres://access:access@localhost:5442/access
