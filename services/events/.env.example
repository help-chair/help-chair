# Copy to .env for local development. Never commit .env or put real secrets here.

# Django settings (services/events/config/settings.py)
SERVICE_NAME=events
DEBUG=True
SECRET_KEY=replace-with-a-local-secret
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Local PostgreSQL from platform/deploy/local/compose.yaml
DATABASE_URL=postgres://events:events@localhost:5441/events

# Container runtime defaults from services/events/Dockerfile
PORT=8001
WEB_CONCURRENCY=2
