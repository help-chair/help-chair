# Copia a .env para desarrollo local. Nunca subas .env ni pongas secretos reales.
# Copy to .env for local development. Never commit .env or put real secrets here.

SERVICE_NAME=incidents
DEBUG=true
# Obligatoria con DEBUG=false. Genera una con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Vacío = SQLite local (db.sqlite3). Para usar la BD del compose desde tu máquina:
#   DATABASE_URL=postgres://incidents:incidents@localhost:5444/incidents
# Dentro del compose la URL ya viene definida (incidents-db:5432).
DATABASE_URL=

# Broker de mensajes (Fase 2; todavía no se usa)
BROKER_URL=

# Contenedor
PORT=8004
WEB_CONCURRENCY=2
